# Database Connection
# If connecting to an external container running on your local machine, use: DB_HOST=host.docker.internal
# If using the db service defined in docker-compose.yml, use: DB_HOST=db
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Server & Ollama Configuration
PORT=3000
OLLAMA_HOST=http://ollama:11434

